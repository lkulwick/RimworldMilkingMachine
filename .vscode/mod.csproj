<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\vs\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj\vs\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <Import Project="..\Build.local.props" Condition="Exists('..\Build.local.props')" />
  <!-- VS 2022 editor/build adapter. The actual mod targets net10.0 in mod.Build.csproj. -->
  <PropertyGroup>
    <ProjectGuid>{BF6F91F1-EBA4-5DA6-C59D-92CD2808FD17}</ProjectGuid>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>RimworldMilkingMachine</RootNamespace>
    <AssemblyName>RimworldMilkingMachine</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <NoStdLib>true</NoStdLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <LangVersion>latest</LangVersion>
    <BaseIntermediateOutputPath>obj\vs\</BaseIntermediateOutputPath>
    <OutputPath>..\RimworldMilkingMachine\1.7\Assemblies\</OutputPath>
    <DotnetPath Condition="'$(DotnetPath)' == ''">dotnet</DotnetPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Source\**\*.cs" />
    <Reference Include="$(RimWorldDir)\System*.dll;$(RimWorldDir)\mscorlib.dll;$(RimWorldDir)\netstandard.dll;$(RimWorldDir)\Assembly-CSharp.dll;$(RimWorldDir)\UnityStubs.dll">
      <Private>false</Private>
    </Reference>
    <None Include="mod.Build.csproj" />
    <None Include="..\Build.local.props" Link="Build.local.props" />
    <None Include="..\README.md" Link="README.md" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Override only real builds; design-time targets still provide C# editing in VS. -->
  <Target Name="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build.ps1&quot; -Configuration $(Configuration) -DotnetPath &quot;$(DotnetPath)&quot;" />
  </Target>
  <Target Name="Rebuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build.ps1&quot; -Configuration $(Configuration) -DotnetPath &quot;$(DotnetPath)&quot; -Rebuild" />
  </Target>
  <Target Name="Clean">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build.ps1&quot; -Configuration $(Configuration) -DotnetPath &quot;$(DotnetPath)&quot; -Clean" />
  </Target>
</Project>
